---
source: crates/skala_server/src/advisor/mod.rs
expression: schema_for!(Advice)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advice",
  "description": "Holds the advice to apply to the reactor.",
  "type": "object",
  "properties": {
    "action": {
      "description": "The best course of action.",
      "$ref": "#/$defs/AdvisedAction"
    },
    "insight_update": {
      "description": "The updated insights into how the system works. If nothing useful has been learned,\nset this to the quoted portion of the 'Past insights' section you were passed in your\nprompt.\n\nIf more has been understood about the system set the new 'insights' here. If present, these\ninsights will be passed to you the next time you need to operate the reactor. You will\nforget all information you do not place here. Setting this field is the only way you have to\nlearn about the system over the long term. If this field is unset, it means that you believe\nthat your current insights are sufficient to operate the reactor safely.",
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning": {
      "description": "A very concise description of the reasoning behind the best course of action. The reasoning description must contain at most 16 words.",
      "type": "string",
      "maxLength": 120
    }
  },
  "required": [
    "action",
    "reasoning"
  ],
  "$defs": {
    "AdvisedAction": {
      "description": "Holds the action to apply to the reactor.",
      "oneOf": [
        {
          "description": "Represents that the reactor's state is okay and hence that no action is required.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "no-action"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Represents that the reactor is either critical or will soon go critical, hence the reaction must be stopped immediately.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scram"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Represents that the burn rate needs to be changed to the given value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "set-burn-rate"
            },
            "new_target_burn_rate": {
              "description": "The value of the new target burn rate.",
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "kind",
            "new_target_burn_rate"
          ]
        }
      ]
    }
  }
}
