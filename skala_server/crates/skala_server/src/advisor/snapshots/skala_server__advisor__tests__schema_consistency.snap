---
source: crates/skala_server/src/advisor/mod.rs
expression: schema_for!(Advice)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advice",
  "description": "Holds the advice to apply to the reactor.",
  "type": "object",
  "properties": {
    "reasoning": {
      "description": "A concise description of the reasoning behind the best course of action (at most 25 words).",
      "type": "string"
    }
  },
  "oneOf": [
    {
      "description": "Represents that the reactor's state is okay and hence that no action is required.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "no-action"
        }
      },
      "required": [
        "action"
      ]
    },
    {
      "description": "Represents that the burn rate needs to be changed to the given value.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set-burn-rate"
        },
        "new-burn-rate": {
          "description": "The value of the new burn rate.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "action",
        "new-burn-rate"
      ]
    }
  ],
  "required": [
    "reasoning"
  ]
}
