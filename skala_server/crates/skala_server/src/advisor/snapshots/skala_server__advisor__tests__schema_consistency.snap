---
source: crates/skala_server/src/advisor/mod.rs
expression: schema_for!(Advice)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advice",
  "description": "Holds the advice to apply to the reactor.",
  "type": "object",
  "properties": {
    "action": {
      "description": "The best course of action.",
      "$ref": "#/$defs/AdvisedAction"
    },
    "reasoning": {
      "description": "The reasoning behind the best course of action.\n\nMax length is 25 words.",
      "type": "string"
    }
  },
  "required": [
    "action",
    "reasoning"
  ],
  "$defs": {
    "AdvisedAction": {
      "description": "Holds the action to apply to the reactor.",
      "oneOf": [
        {
          "description": "Represents that the reactor's state is okay and hence that no action is required.",
          "type": "string",
          "const": "no-action"
        },
        {
          "description": "Represents that the reactor is either critical or will soon go critical, hence the reaction must be stopped immediately.",
          "type": "string",
          "const": "scram"
        }
      ]
    }
  }
}
