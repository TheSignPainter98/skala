local *

import 'cc.strings' as :wrap

macro version = ->
  "'#{os.date!}'"
_VERSION = $version!

unpack ??= table.unpack

main = ->
  ctx =
    active: true
  parallel.waitForAny unpack
    * -> trigger_by_time ctx
    * -> trigger_by_redstone ctx
    * -> react ctx
  error 'unreachable'

trigger_by_time = (ctx) ->
  while true
    timer_id = os.startTimer 60 * 5
    local id
    repeat
      _, id = os.pullEvent 'timer'
    until id == timer_id
    print 'activating due to timer'
    ctx.active = true

trigger_by_redstone = (ctx) ->
  sides = redstone.getSides!
  while true
    os.pullEvent 'redstone'

    high = false
    for side in *sides
      if redstone.getInput side
        high = true
        break
    if high
      print 'activating due to redstone'
      ctx.active = true

react = (ctx) ->
  ai = Ai 'http://localhost:8326'

  while true
    if not ctx.active
      coroutine.yield!
      continue
    ctx.active = false

    reactor, err = Reactor::find!
    if err?
      print "cannot find reactor: #{err}"
      continue
    state = reactor\state!

    print 'analysing reactor state'
    { :action_required, :recommended_action } = ai\request_advice state
    if not action_required
      print 'no action required'
      continue

    print 'writing report'
    printer = peripheral.find 'printer'
    if not printer?
      print 'no printer'
      continue
    err = print_report printer, state, recommended_action
    if err?
      print "cannot print report: #{err}"
      continue

print_report = (printer, state, recommended_action) ->
  if not printer.newPage!
    return 'error: cannot print due to missing paper, ink or output space'

  state_entries = [ v for _, v in pairs state ]
  table.sort state_entries, (a, b) -> a.name, b.name

  { :hour, :min, :sec } = os.date '!*t'
  time_str = "#{hour}:#{min}:#{sec}"

  width, height = printer.getPageSize!

  lines = with {}
    [] = '>> S.K.A.L.A. report'
    [] = ">> (#{time_str})"

    [] = ''
    [] = '> Recommendation:'
    [] = ''
    [] = recommended_action

    [] = ''
    [] = '> Reactor state:'
    [] = ''
    longest_name = 0
    longest_value = 0
    entries = with {}
      for state_entry in *state_entries
        if state_entry.print?
          if not state_entry.print
            continue

        name = state_entry.print_name ?? state_entry.name
        if #name > longest_name
          longest_name = #name

        value = state_entry.print_value ?? state_entry.value
        if #value > longest_value
          longest_value = #value

        [] =
          :name
          :value
    if longest_name + longest_value + 2 <= width
      for { :name, :value } in *entries
        padding = ' '\rep 2 + longest_name - #name
        [] = "#{name}#{padding}#{value}"
    else
      for { :name, :value } in *entries
        [] = "#{name}: #{value}"

  pages = with {}
    current_page = {}
    for line in *lines
      for l in *wrap line, width
        current_page[] = l
        if #current_page == height
          [] = current_page
          current_page = {}
    if #current_page > 0
      [] = current_page

  if #pages > printer.getInkLevel!
    return "insufficient ink for #{#pages} pages"
  if #pages > printer.getPaperLevel!
    return "insufficient paper for #{#pages} pages"

  for i = 1, #pages
    page = pages[i]

    if i > 1
      printer.newPage!

    if #pages > 1
      printer.setPageTitle "Skala Reactor Report (#{i}/#{#pages})"
    else
      printer.setPageTitle "Skala Reactor Report"
    for line_num = 1, #page
      printer.setCursorPos 1, line_num
      printer.write page[line_num]

    printer.endPage!

  nil

fe_to_j = (fe) -> fe * 2.5

class Ai
  new: (@address) =>
    assert @address, 'no address'

  request_advice: (state) =>
    prompt_parts = with {}
      [] = 'Be concise.'
      [] = 'Do not patronise.'
      [] = 'You are an RBMK nuclear reactor control computer.'
      for _, v in pairs state
        [] = "The #{v.name} is #{v.value}."
      [] = 'If this is concerning, report why you are concerned and what the operator should do to remedy the situation, otherwise, just say "no".'
      [] = '\n'
    prompt = table.concat prompt_parts, ' '

    -- local raw_advice
    -- with assert io.popen 'qwen-vl chat'
    --   print 'writing prompt'
    --   \write prompt
    --   print 'flushing'
    --   \flush!
    --   print 'reading advice'
    --   raw_advice = \read '*a'
    --   \close!
    raw_advice = "core temperature critical. Increase temperature immediately."

    recommended_action = nil
    action_required = not (raw_advice\sub 1, 3)\lower!\match '^No.'
    if action_required
      recommended_action = raw_advice
    {
      :action_required
      :recommended_action
    }

class Reactor
  new: (@reactor) =>

  @find: =>
    reactor = peripheral.find 'fissionReactorLogicAdapter'
    if not reactor?
      return nil, 'cannot find fission reactor logic adaptor'
    ret = @@ reactor
    ret, nil

  state: =>
    TICKS_PER_SECOND = 20
    KELVIN_OFFSET = 273.15
    with {}
      .status =
        name: 'reactor'
        print_name: 'status'
        value: switch @reactor.getStatus!
          when true
            'active'
          when false
            'inactive'
          else
            error 'unreachable'
      .temperature =
        name: 'core temperature'
        print_name: 'core temp'
        value: '%.2f°C'\format @reactor.getTemperature! - KELVIN_OFFSET
        print_value: '%.2fC'\format @reactor.getTemperature! - KELVIN_OFFSET
      .coolant_filled =
        name: 'coolant level'
        print_name: 'coolant lvl'
        value: '%.2f%%'\format 100 * @reactor.getCoolantFilledPercentage!
      .heated_coolant_filled =
        name: 'heated coolant level'
        print_name: 'hot coolant lvl'
        value: '%.2f%%'\format 100 * @reactor.getHeatedCoolantFilledPercentage!
      .fuel_filled =
        name: 'fuel level'
        print_name: 'fuel lvl'
        value: '%.2f%%'\format 100 * @reactor.getFuelFilledPercentage!
      .waste_filled =
        name: 'waste level'
        print_name: 'waste lvl'
        value: '%.2f%%'\format 100 * @reactor.getWasteFilledPercentage!
      .actual_burn_rate =
        name: 'burn rate'
        value: '%.2fmB/s'\format @reactor.getActualBurnRate! * TICKS_PER_SECOND
      .target_burn_rate =
        name: 'target burn rate'
        print_name: 'goal burn rate'
        value: '%.2fmB/s'\format @reactor.getBurnRate! * TICKS_PER_SECOND
        print: false
      .damage_percent =
        name: "reactor's damage"
        print_name: 'damage'
        value: '%.2f%%'\format 100 * @reactor.getDamagePercent!
      .heating_rate =
        name: 'heating rate'
        value: '%.2fmB/s'\format @reactor.getHeatingRate! * TICKS_PER_SECOND
      .boil_efficiency =
        name: 'boil efficiency'
        print_name: 'boil effncy'
        value: '%.2f%%'\format 100 * @reactor.getBoilEfficiency!

main!
