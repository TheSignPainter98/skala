local *

unpack ??= table.unpack

main = ->
  ctx =
    active: true
  parallel.waitForAny unpack
    * -> trigger_by_time ctx
    * -> trigger_by_redstone ctx
    * -> react ctx
  error 'unreachable'

trigger_by_time = (ctx) ->
  timer_id = os.startTimer 60
  while true
    _, id = os.pullEvent 'timer'
    if id == timer_id
      ctx.active = true

trigger_by_redstone = (ctx) ->
  sides = redstone.getSides!
  while true
    os.pullEvent 'redstone'

    high = false
    for side in *sides
      if redstone.getInput side
        high = true
        break
    if high
      ctx.active = true

react = (ctx) ->
  ai = Ai 'http://localhost:8326'

  while true
    if not ctx.active
      coroutine.yield!
      continue
    ctx.active = false

    reactor, err = Reactor::find!
    if err?
      print "cannot find reactor: #{err}"
      continue
    state = reactor\state!

    { :action_required, :recommended_action } = ai\request_advice state
    if action_required
      print 'no action required'
      continue

    printer = peripheral.find 'printer'
    if not printer?
      print 'error: no printer'
      continue
    err = print_report printer, state, recommended_action
    if err?
      print "cannot print report: #{err}"
      continue

print_report = (printer, state, recommended_action) ->
  if not printer.newPage!
    return 'error: cannot print due to missing paper or ink'

  state_entries = [ v for _, v in pairs state ]
  table.sort state_entries, (a, b) -> a.name, b.name

  { :hour, :min, :sec } = os.date '!*t'
  time_str = "#{hour}:#{min}:#{sec}"

  printer.setPageTitle 'Skala Reactor Report'
  printer.write 'Reactor state:\n'
  for state_entry in *state_entries
    printer.write "#{time_str}: #{state_entry.name}: #{state_entry.value}\n"
  printer.write 'Recommended action:\n'
  printer.write recommended_action

  printer.endPage!

  nil

fe_to_j = (fe) -> fe * 2.5

class Ai
  new: (@address) =>
    assert @address, 'no address'

  request_advice: (state) =>
    prompt_parts = with {}
      [] = 'Be concise.'
      [] = 'Do not patronise.'
      [] = 'You are a nuclear reactor control computer.'
      for _, v in pairs state
        [] = "The #{v.name} is at #{v.value}."
      [] = 'If this is concerning, report why you are concerned and what the operator should do to remedy the situation, otherwise, just say "no".'
      [] = '\n'
    prompt = table.concat prompt_parts, ' '

    local raw_advice
    with assert io.popen 'qwen-vl chat'
      print 'writing prompt'
      \write prompt
      print 'flushing'
      \flush!
      print 'reading advice'
      raw_advice = \read '*a'
      \close!

    print "got raw advice: #{raw_advice}"

    recommended_action = nil
    action_required = (raw_advice\sub 1, 10)\lower!\match '^No.'
    if action_required
      recommended_action = raw_advice
    {
      :action_required
      :recommended_action
    }

class Reactor
  new: (@reactor) =>

  @find: =>
    reactor = peripheral.find 'fissionReactorLogicAdapter'
    if not reactor?
      return nil, 'cannot find fission reactor logic adaptor'
    ret = @@ reactor
    ret, nil

  state: =>
    TICKS_PER_SECOND = 20
    KELVIN_OFFSET = 273.15
    with {}
      .status =
        name: 'reactor'
        value: switch @reactor.getStatus!
          when true
            'active'
          when false
            'inactive'
          else
            error 'unreachable'
      .temperature =
        name: 'core temperature'
        value: "#{@reactor.getTemperature! - KELVIN_OFFSET} Celsius"
      .coolant_filled =
        name: 'coolant level'
        value: "#{100 * @reactor.getCoolantFilledPercentage!}%"
      .heated_coolant_filled =
        name: 'heated coolant level'
        value: "#{100 * @reactor.getHeatedCoolantFilledPercentage!}%"
      .fuel_filled =
        name: 'fuel level'
        value: "#{100 * @reactor.getFuelFilledPercentage!}%"
      .waste_filled =
        name: 'waste level'
        value: "#{100 * @reactor.getWasteFilledPercentage!}%"
      .actual_burn_rate =
        name: 'burn rate'
        value: "#{@reactor.getActualBurnRate! * TICKS_PER_SECOND}mB/s"
      .target_burn_rate =
        name: 'target burn rate'
        value: "#{@reactor.getBurnRate! * TICKS_PER_SECOND}mB/s"
      .damage_percent =
        name: "reactor's damage"
        value: "#{100 * @reactor.getDamagePercent!}%"
      .heating_rate =
        name: 'heating rate'
        value: "#{@reactor.getHeatingRate! * TICKS_PER_SECOND}mB/s"
      .boil_efficiency =
        name: 'boil efficiency'
        value: "#{100 * @reactor.getBoilEfficiency!}%"

main!
