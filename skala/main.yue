local *

-- Changes global state, this must come first
require 'skala.compat'

import 'skala.clap' as :ArgParser
import 'skala.quicktype' as :declare_type

import 'skala.command.autostart'
import 'skala.command.chat'
import 'skala.command.flash'
import 'skala.command.install'
import 'skala.command.start'
import 'skala.command.uninstall'

declare_type 'skala.Reactor', [[{
  activate: () -> <>,
  scram: () -> <>,
  getStatus: () -> boolean,
  -- getTemperature: () -> number,
  -- getDamagePercent: () -> number,
  -- getCoolant: () -> skala.Chemical,
  -- getCoolangFilledPercentage: () -> number,
  -- getHeatedCoolant: () -> skala.Chemical,
  -- getHeatedCoolantFilledPercentage: () -> number,
  -- getFuel: () -> skala.Chemical,
  -- getFuelFilledPercentage: () -> skala.Chemical,
  -- getFuelNeeded: () -> number,
  -- getFuelCapacity: () -> number,
  -- getWaste: () -> number,
  -- getWaste: () -> number,
}]]
declare_type 'skala.Chemical', [[{
  name: string,
  amount: string,
}]]

main = (raw_args) ->
  args, ok = parse_args raw_args
  if not ok
    return

  if a = args.autostart
    autostart.main a
  else if a = args.start
    start.main a
  else if a = args.chat
    chat.main a
  else if a = args.flash
    flash.main a
  else if a = args.install
    install.main a
  else if a = args.uninstall
    uninstall.main a
  else
    error 'unreachable'

parse_args = (args) ->
  parser = with ArgParser 'skala'
    \version '1.0'
    \description 'reactor control system'

  autostart.register_args parser
  chat.register_args parser
  flash.register_args parser
  install.register_args parser
  start.register_args parser
  uninstall.register_args parser

  parser\parse args

main {...}
