local *

import 'skala.quicktype' as :declare_type, :F, :T
import 'skala.quicktype_macros' as $

declare_type 'waker.Waker', [[{
  add_trigger: (waker.Trigger) => Self,
  on_awaken: (() -> <>) => <>,
  awaken: () => <>,
  run: () => !,
}]]
declare_type 'waker.Trigger', [[{
  run: (waker.Waker) => !,
}]]
declare_type 'waker.Listener', '(?string) -> <>'
export class Waker
  new: $F '() => <>', =>
    @_triggers = $T '[waker.Trigger]', {}
    @_awake = $T '?string | boolean', false
    @_awaken_listeners = $T '[waker.Listener]', {}

  add_trigger: $F '(waker.Trigger) => Self', (trigger) =>
    @_triggers[] = trigger
    @

  on_awaken: $F '(waker.Listener) => Self', (listener) =>
    @_awaken_listeners[] = listener
    @

  awaken: $F '(?some) => <>', (label) =>
    @_awakened_label ??= label
    @_awakened = true

  @run_many: F '([waker.Waker]) => !', (wakers) =>
    parallel.waitForAny unpack with {}
      for waker in *wakers
        for task in *waker\_tasks!
          [] = task
    error 'unreachable'

  run: $F '() => !', =>
    parallel.waitForAny unpack @_tasks!

  _tasks: $F '() => [() -> <>]', =>
    with {}
      for trigger in *@_triggers
        [] = -> trigger\run @
      [] = @\_awakener

  _awakener: $F '() => !', =>
    while true
      if not @_awakened
        coroutine.yield!
        continue
      @_awakened = false

      for listener in *@_awaken_listeners
        listener @_awakened_label
      @_awakened_label = nil

export class PeriodicTrigger
  new: $F '(?{name: ?string, interval: number}) => <>', (opts={}) =>
    {
      name: @_name
      interval: @_interval
    } = opts

  run: $F '(waker.Waker) => !', (ctx) =>
    while true
      timer_id = os.startTimer @_interval
      local id
      repeat
        _, id = os.pullEvent 'timer'
      until id == timer_id
      ctx\awaken @_name
    error 'unreachable'

declare_type 'cc.Side', [[
  "top"|"bottom"|"left"|"right"|"front"|"back"
]]
export class RedstoneTrigger
  new: $F '(?{name: ?string, side: ?cc.Side}) => <>', (opts={}) =>
    {
      name: @_name
      side: @_side
    } = opts

  run: $F '(waker.Waker) => !', (ctx) =>
    local sides_to_check
    if @_side?
      sides_to_check = { @_side }
    else
      sides_to_check = redstone.getSides!

    while true
      os.pullEvent 'redstone'

      high = false
      for side in *sides_to_check
        if redstone.getInput side
          high = true
          break
      if not high
        continue
      ctx\awaken @_name
    error 'unreachable'

export class NetworkObserver
  new: $F '({name: ?string, protocol: ?string}) => <>', (opts={}) =>
    {
      name: @_name
      protocol: @_protocol
    } = opts

  run: $F '(waker.Waker) => !', (ctx) =>
    while true
      id, message = rednet.receive @_protocol
      ctx\awaken $T '{name: ?string, id: number, message: some}',
        name: @_name
        :id
        :message
    error 'unreachable'
