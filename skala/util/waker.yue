local *

import 'skala.quicktype' as :declare_type, :F, :T
import 'skala.quicktype_macros' as $

declare_type 'waker.Waker', [[{
  add_trigger: (waker.Trigger) => Self,
  on_awaken: (() -> <>) => <>,
  awaken: () => <>,
  run: () => !,
}]]
declare_type 'waker.Trigger', [[{
  run: (waker.Waker) => !,
}]]
declare_type 'waker.Listener', '(?string) -> <>'
export class Waker
  new: $F '() => <>', =>
    @_triggers = $T '[{name: ?string, trigger: waker.Trigger}]', {}
    @_awake = $T '?string | boolean', false
    @_awaken_listeners = $T '[waker.Listener]', {}

  add_trigger: $F '(waker.Trigger) => Self', (trigger) =>
    @_triggers[] = :trigger
    @

  add_named_trigger: $F '(string, waker.Trigger) => Self', (name, trigger) =>
    @_triggers[] =
      :name
      :trigger
    @

  on_awaken: $F '(waker.Listener) => Self', (listener) =>
    @_awaken_listeners[] = listener
    @

  awaken: $F '(?label) => <>', (@_awakened_by=true) =>

  run: $F '() => !', =>
    parallel.waitForAny unpack with {}
      for trigger in *@_triggers
        [] = -> trigger\run @
      [] = @\_awakener
    error 'unreachable'

  -- tasks: $F '() => []', =>
    -- TODO(kcza): expose task list,

  _awakener: $F '() => !', =>
    while true
      if not @_awakened_by
        coroutine.yield!
        continue

      for listener in *@_awaken_listeners
        listener @_awakened_by
      @_awakened_by = false

export class PeriodicTrigger
  new: $F '(?{name: ?string, interval: number}) => <>', (opts={}) =>
    {
      name: @_name
      interval: @_interval
    } = opts

  run: $F '(waker.Waker) => !', (ctx) =>
    while true
      timer_id = os.startTimer @_interval
      local id
      repeat
        _, id = os.pullEvent 'timer'
      until id == timer_id
      ctx\awaken @_name

declare_type 'cc.Side', [[
  "top"|"bottom"|"left"|"right"|"front"|"back"
]]
export class RedstoneTrigger
  new: $F '(?{name: ?string, side: ?cc.Side}) => <>', (opts={}) =>
    {
      name: @_name
      side: @_side
    } = opts

  run: $F '(waker.Waker) => !', (ctx) =>
    local sides_to_check
    if @_side?
      sides_to_check = { @_side }
    else
      sides_to_check = redstone.getSides!

    while true
      os.pullEvent 'redstone'

      high = false
      for side in *sides_to_check
        if redstone.getInput side
          high = true
          break
      if not high
        continue
      ctx\awaken @_name
