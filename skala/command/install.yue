local *

import 'skala.quicktype' as :is, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Flag, :Param, :Subcommand
import 'skala.command.autostart' as :CONFIG_FILE
import 'skala.command.start' as :NODE_KINDS, :NODE_SPECS
import 'skala.editor' as :ABORT, :Editor

import 'skala.command.start.control'
import 'skala.command.start.killswitch'
import 'skala.command.start.observer'
import 'skala.util.toml'

export register_args = (parser) ->
  parser\add with Subcommand 'install'
    \description 'make this computer run autostart on startup'
    \add with Flag 'pastebin'
      \description 'hash of pastebin file to download'
      \takes_param!
    \add with Flag 'force'
      \description 'overwrite existing startup.lua'
    \add with Param 'kind'
      \description 'the kind of this node'
      \options NODE_KINDS

export main = (args) ->
  autodownload_shim = ""
  if args.pastebin?
    autodownload_shim = "
      if redstone.getAnalogInput('top') > 4 then
        print('downloading skala')
        shell.run('pastebin', 'get', '#{args.pastebin}', '.skala~')

        print('copying .skala~ -> skala')
        fs.delete('skala')
        fs.move('.skala~', 'skala')
      end
    "
  code = "
    #{autodownload_shim}
    shell.run('skala', 'autostart')
  "

  if not args.force
    -- Race condition here :)
    with? io.open 'startup.lua', 'r'
      assert \close!
      print "file `startup.lua' already exists."
      print "pass --force to overwrite it"
      return

  local config
  with Editor!
    expected_type = 'any' -- TODO(kcza): complete me!
    checker = (raw) ->
      config, err = toml.decode raw
      if err?
        print err
        return false
      _, err = is expected_type, config
      if err?
        print err
        return false
      true

    on_attempt = (file_name, attempt) ->
      print "press [ENTER] edit #{file_name}, [q] to abort"
      switch io.read '*l'
        when 'q'
          ABORT
        when ''
          nil

    config = config_for args.kind
    config, err = \edit_text config, CONFIG_FILE, checker, on_attempt
    if err?
      print err
      return

  with assert io.open 'startup.lua', 'w+'
    assert \write code
    assert \close!

  with assert io.open CONFIG_FILE, 'w+'
    assert \write config
    assert \close!

config_for = $F '(string) -> string', (kind) ->
  spec = NODE_SPECS[kind]
  if not spec?
    error "unknown skala node kind `#{kind}'"
  spec.DEFAULT_CONFIG
