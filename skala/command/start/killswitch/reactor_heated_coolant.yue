local *

import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand
import 'skala.util.sole_peripheral' as :sole_peripheral

export register_args = (parser) ->
  parser\add with Subcommand 'reactor-heated-coolant'
    \description 'scram reactor on insufficient used-coolant space'

declare_type 'reactor_temp.Args', [[{
  max_coolant_percent: ?number,
}]]

export DEFAULT_CONFIG_LINES =
  * 'max_coolant_percent = 50'

export check_reactor = $F '(reactor_temp.Args, skala.Reactor) -> <?killswitch.Action, ?string>', (args, reactor) ->
  { :max_coolant_percent = 80 } = args

  coolant = reactor.getHeatedCoolant!
  coolant_capacity = reactor.getHeatedCoolantCapacity!
  coolant_percent = 100 * coolant / coolant_capacity

  print "reactor heated coolant level is #{coolant_percent}%, min is #{min_coolant_percent}%"
  if coolant_percent > max_coolant_percent
    return 'SCRAM', nil
  nil, nil
