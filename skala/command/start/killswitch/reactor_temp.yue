local *

import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand
import 'skala.util.sole_peripheral' as :sole_peripheral

export register_args = (parser) ->
  parser\add with Subcommand 'reactor-temp'
    \description 'scram reactor on excessive temperature'

declare_type 'reactor_temp.Args', [[{
  max_temperature: ?number,
}]]

export check_reactor = $F '(reactor_temp.Args) -> ?string', (args) ->
  reactor, err = sole_peripheral 'fissionReactorLogicAdapter'
  if err?
    return err

  if not reactor.getStatus!
    print 'reactor inactive'
    return -- Inactive.

  { :max_temperature } = args

  temperature = reactor.getTemperature!
  print "reactor temperature is #{temperature}, max is #{max_temperature}"
  if temperature > max_temperature
    print '!!! scramming reactor !!!'
    reactor.scram!
