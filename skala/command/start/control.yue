local *

-- Ensure type definitions are included.
require 'skala.command.start.control.codec'

-- import 'cc.strings' as :wrap
import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand, :Flag
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger
import 'skala.command.start.control.codec.basic_serious' as :BasicSerious
import 'skala.command.start.control.open_ai_llm' as :Llm
import 'skala.peripheral.reactor' as :Reactor

declare_type 'control.Heartbeat', [[{
  id: number,
  type: string,
  subtype: ?string,
  datetime: {
    hour: number,
    minute: number,
    sec: number,
  }
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'control'
    \description 'default reactor control system'
    \add with Flag 'attitude'
      \description 'interaction behaviour with LLM'
      \short nil
      \default 'serious'
    \add with Flag 'llm-timeout'
      \description 'complete LLM response max seconds'
      \short nil
      \default 10

declare_type 'control.Args', [[{
  attitude: control.Attitude,
  llm_timeout: number,

}]]
declare_type 'control.Attitude', [[
  "serious"
  | "skittish"
  | "saucy"
]]

export DEFAULT_CONFIG = do
  lines =
    * '[control]'
    * ''
  table.concat lines, '\n'

export main = $F '(control.Args) -> <>', (args) ->
  ai = Ai
    base_url: 'http://localhost:8326/v1'
    model: "qwen-vl"
    codec: BasicSerious!

  with Waker!
    \add_trigger PeriodicTrigger
      interval: 60 * 5
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      reactor, err = Reactor::find!
      if err?
        print "cannot find reactor: #{err}"
        return
      reactor_state, err = reactor\state!
      if err?
        print "cannot get reactor state: #{err}"
        return

      print 'reactor_state is...'
      (require 'cc.pretty').pretty_print reactor_state
      -- TODO(kcza): control with the AI
      -- TODO(kcza): log its advice
    \awaken! -- Kick-start
    \run!

react = ->
  while true
    if not ctx.active
      coroutine.yield!
      continue
    ctx.active = false

    print 'analysing reactor state'
    { :action_required, :recommended_action } = ai\request_advice state
    if not action_required
      print 'no action required'
      continue

    print 'writing report'
    printer = peripheral.find 'printer'
    if not printer?
      print 'no printer'
      continue
    err = print_report printer, state, recommended_action
    if err?
      print "cannot print report: #{err}"
      continue

fe_to_j = (fe) -> fe * 2.5

declare_type 'control.ReactorAdvice', [[{
  action_required: boolean,
  recommended_action: control.RecommendedAction,
}]]
declare_type 'control.RecommendedAction', [[{}]] -- TODO(kcza): complete me!
class Ai
  new: $F '({base_url: string, model: string, codec: control.LlmCodec}) => <>', (opts) =>
    {
      :base_url
      :model
      codec: @_codec
    } = opts
    role = @_codec\role!
    @_llm = Llm
      :base_url
      :role
      :model

  request_advice: $F '(peripheral.ReactorState) => <?control.ReactorAdvice, ?string>', (state) =>
    request = @_codec\encode state
    raw_advice, err = @_llm\ask request
    if err?
      return nil, err
    advice, err = @_codec\decode raw_advice
    if err?
      return nil, err
    advice, nil
