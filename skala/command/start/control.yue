local *

-- import 'cc.strings' as :wrap
import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand
import 'skala.util.text' as :concat_words
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger

declare_type 'control.Heartbeat', [[{
  id: number,
  type: string,
  subtype: ?string,
  datetime: {
    hour: number,
    minute: number,
    sec: number,
  }
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'control'
    \description 'default reactor control system'

declare_type 'control.Args', [[{
  attitude: control.Attitude,
}]]
declare_type 'control.Attitude', [[
  "serious"
  | "skittish"
  | "saucy"
]]

export DEFAULT_CONFIG = do
  lines =
    * '[control]'
    * ''
  table.concat lines, '\n'

export main = $F '(control.Args) -> <>', (args) ->
  ai = Ai 'http://localhost:8326/v1'

  with Waker!
    \add_trigger PeriodicTrigger
      interval: 60 * 5
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      reactor, err = Reactor::find!
      if err?
        print "cannot find reactor: #{err}"
        return
      reactor_state, err = reactor\state!
      -- TODO(kcza): control with the AI
    state = reactor\state!
    \run!

react = ->
  while true
    if not ctx.active
      coroutine.yield!
      continue
    ctx.active = false

    print 'analysing reactor state'
    { :action_required, :recommended_action } = ai\request_advice state
    if not action_required
      print 'no action required'
      continue

    print 'writing report'
    printer = peripheral.find 'printer'
    if not printer?
      print 'no printer'
      continue
    err = print_report printer, state, recommended_action
    if err?
      print "cannot print report: #{err}"
      continue

fe_to_j = (fe) -> fe * 2.5

declare_type 'control.ReactorAdvice', [[{
  action_required: boolean,
  recommended_action: control.RecommendedAction,
}]]
declare_type 'control.RecommendedAction', [[{}]] -- TODO(kcza): complete me!
class Ai
  new: $F '(string) => <>', (@_url) =>
    @_role = concat_words with {}
      [] = 'Be concise.'
      [] = 'Do not patronise.'
      [] = 'You are an RBMK nuclear reactor control computer.'
    @_llm = Llm @_url, @_role

  request_advice: $F '(peripheral.ReactorState) => <?control.ReactorAdvice, ?string>', (state) =>
    request = concat_words with {}
      for k, v in pairs state
        [] = "The reactor's #{k} is #{v}."
      [] = 'If this is concerning, report why you are concerned and what the operator should do to remedy the situation, otherwise, just say "no".'
      [] = '\n'
    raw_advice, err = @_llm\ask request
    raw_advice = "core temperature critical. Increase temperature immediately."

    recommended_action = nil
    action_required = not (raw_advice\sub 1, 3)\lower!\match '^No.'
    if action_required
      recommended_action = raw_advice
    ret = {
      :action_required
      :recommended_action
    }
    ret, nil

export class Llm
  new: $F '(string, string) => <>', (@_url, @_role) =>
    @_history = $T '[string]', {}

  ask: $F '(string) => <?string, ?string>', (request) =>
    @_history[] = "user: #{message}"

    params =
      ['x-message']: textutils.serialiseJSON @_history
      ['x-role']: @_role
    response, err = http.post @_address, 'string', params
    if err?
      return nil, err

    response_text = concat_words with {}
      while true
        line = response.readLine!
        if not line?
          break
        [] = line
    @_history[] = "bot: #{response_text}"

    response_text, nil
