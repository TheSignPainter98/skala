local *

import 'skala.quicktype' as :declare_type, :F, :T
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand, :Flag
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger
import 'skala.util.sole_peripheral' as :sole_peripheral

import 'skala.command.start.killswitch.reactor_temp'

export register_args = (parser) ->
  command = with Subcommand 'killswitch'
    \description 'reactor auto-shutoff actors'
    \add with Flag 'frequency'
      \description 'how many times per second to check the reactor'
      \takes_param!
      \default 2
      \transform (raw) ->
        if n = tonumber raw
          n, nil
        else
          nil, "#{raw} is not a number"
  reactor_temp.register_args command
  parser\add command

declare_type 'killswitch.KillSwitch', [[{

}]]
killswitches = $T '{string->killswitch.KillSwitch}', {
  :reactor_temp
}
sorted_killswitches = $T '[killswitch.KillSwitch]', do
  sorted_killswitches = [ { :name, :module } for name, module in pairs killswitches ]
  table.sort sorted_killswitches, (a, b) -> a.name < b.name
  sorted_killswitches

export DEFAULT_CONFIG = do
  lines = with {}
    [] = '[killswitch]'
    [] = 'frequency = 2'
    [] = ''
    [] = '# Killswitch config below. Uncomment one table.'
    for killswitch in *sorted_killswitches
      { :name, :module } = killswitch
      [] = ''
      [] = "# [killswitch.#{name}]"
      for line in *module.DEFAULT_CONFIG_LINES
        [] = "# #{line}"
    [] = ''
  table.concat lines, '\n'

declare_type 'killswitch.Args', [[{
  frequency: number
}]]
export main = $F '(killswitch.Args) -> <>', (args) ->
  { :frequency } = args

  import 'skala.spec' as :repr
  print repr args

  check_reactor = nil
  for { :name, :module } in *sorted_killswitches
    a = args[name]
    if not a?
      continue

    if check_reactor?
      error 'multiple killswitches set'
    check_reactor = (reactor) ->
      module.check_reactor a, reactor
  if not check_reactor?
    error 'no killswitch kind set'

  with Waker!
    \add_trigger PeriodicTrigger 1 / args.frequency
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      { :hour, :min, :sec } = os.date '!*t'
      print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec

      reactor, err = sole_peripheral 'fissionReactorLogicAdapter'
      if err?
        print err
        return

      reactor_usable = false
      try
        reactor_usable or= reactor.getStatus!
      catch err
        print err
      if not reactor_usable
        return

      err = check_reactor reactor
      if err?
        print err
    \awaken!
    \run!
