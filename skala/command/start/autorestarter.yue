local *

import 'skala.clap' as :Subcommand, :Flag
import 'skala.peripheral.reactor' as :Reactor
import 'skala.quicktype' as :declare_type, :F, :T
import 'skala.quicktype_macros' as $
import 'skala.util.waker' as :Waker, :PeriodicTrigger

export register_args = (parser) ->
  parser\add with Subcommand 'autorestarter'
    \description 'auto restart the reactor'

declare_type 'autorestarter.Args', [[{
  check_interval_seconds: ?number,
  min_coolant_percent: ?number,
  min_fuel_percent: ?number,
  max_damage_percent: ?number,
  max_heated_coolant_percent: ?number,
  max_waste_percent: ?number,
  max_temperature: ?number,
}]]
declare_type 'autorestarter.Action', [[
  "RESTART"
]]

export DEFAULT_CONFIG = do
  lines =
    * '[autorestarter]'
    * 'check_interval_seconds = 10'
    * 'min_coolant_percent = 100'
    * 'min_fuel_percent = 25'
    * 'max_damage_percent = 0'
    * 'max_heated_coolant_percent = 25'
    * 'max_waste_percent = 25'
    * 'max_temperature = 400'
  table.concat lines, '\n'

export main = $F '(autorestarter.Args) -> !', (args) ->
  { :check_interval_seconds = 10 } = args

  with Waker!
    \add_trigger PeriodicTrigger
      interval: check_interval_seconds
    \on_awaken ->
      action, err = check_reactor args
      if err?
        print err
      switch action
        when 'RESTART'
         reactor.activate!
        when nil
          -- Do nothing
        else
          print "unrecognised action #{action}"
    \awaken!
    \run!

declare_type 'autorestarter.Condition', [[{
  name: string,
  held: ?{
    name: string,
    amount: number,
  },
  capacity: number,
  min_percent: ?number,
  max_percent: ?number,
}]]
check_reactor = $F '(autorestarter.Args) -> <?autorestarter.Action, ?string>', (args) ->
  reactor, err = Reactor::find!
  if err?
    return nil, err

  if reactor.getStatus!
    return nil, nil -- Already active.

  high = false
  for side in *redstone.getSides!
    if redstone.getInput side
      high = true
      continue
  if not high
    { :hour, :min, :sec } = os.date '!*t'
    print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec
    return nil, nil -- Auto-restart not requested

  if not reactor.isFormed!
    return nil, 'reactor not formed' -- Not usable.

  {
    :min_coolant_percent = 100
    :min_fuel_percent = 25
    :max_damage_percent = 0
    :max_heated_coolant_percent = 25
    :max_waste_percent = 25
    :max_temperature = 400
  } = args

  { :hour, :min, :sec } = os.date '!*t'
  print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec

  conditions = $T '[autorestarter.Condition]', {{
    name: 'coolant'
    held: reactor.getCoolant!
    capacity: reactor.getCoolantCapacity!
    min_percent: min_coolant_percent
  }, {
    name: 'fuel'
    held: reactor.getFuel!
    capacity: reactor.getFuelCapacity!
    min_percent: min_fuel_percent
  }, {
    name: 'damage'
    held:
      name: 'damage'
      amount: reactor.getDamagePercent!
    capacity: 100
    max_percent: max_damage_percent
  }, {
    name: 'heated coolant'
    held: reactor.getHeatedCoolant!
    capacity: reactor.getHeatedCoolantCapacity!
    max_percent: max_heated_coolant_percent
  }, {
    name: 'waste'
    held: reactor.getWaste!
    capacity: reactor.getWasteCapacity!
    max_percent: max_waste_percent
  }, {
    name: 'temperature'
    held: reactor.getTemperature!
    capacity: 1
    max_percent: max_temperature
    unit: 'K'
  }}
  -- TODO(kcza): check the turbine has sufficient space

  reactor_safe = true
  for condition in *conditions
    {
      :name
      :held
      :capacity
      :min_percent
      :max_percent
      :unit = '%'
    } = condition
    if not held?
      print "#{name} not found"
      reactor_safe = false
      continue

    { :amount, :name } = held
    proportion = amount / capacity
    if min_percent?
      if proportion >= min_percent / 100
        continue
      print "too little #{name}: need #{min_percent}#{unit} have #{proportion * 100}#{unit}"
    if max_percent
      if proportion <= max_percent / 100
        continue
      print "too much #{name}: need at most #{max_percent}#{unit} have #{proportion * 100}#{unit}"
    reactor_safe = false

  if reactor_safe
    return 'RESTART', nil
