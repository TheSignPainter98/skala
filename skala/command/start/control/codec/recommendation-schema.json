{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reactor Action Recommendation Schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "The recommended type of action.",
      "enum": ["no-action-required", "scram", "set"]
    },
    "reason": {
      "type": "string",
      "description": "A concise rationale explaining why the specified action was recommended. At most 25 words, at least 4."
    }
  },
  "required": ["action", "reason"],
  "if": {
    "properties": {
      "action": {
        "const": "set"
      }
    }
  },
  "then": {
    "properties": {
      "parameter": {
        "type": "string",
        "description": "the value of the parameter being set",
        "enum": ["target-burn-rate", "waste-removal-rate"]
      },
      "value": {
        "type": "number",
        "description": "the value of the parameter",
        "minimum": 0,
        "maximum": 1
      }
    },
    "required": ["parameter", "value"]
  }
}
