local *

import 'skala.quicktype' as :F, :declare_type, :is
import 'skala.quicktype_macros' as $
import 'skala.util.text' as :concat_words, :concat_lines, :strip_prefix, :strip_suffix, :reindent

macro include_str = (path) ->
  path = path\sub 2, #path - 1
  local content
  with assert io.open path, 'r'
    content = assert \read '*a'
    assert \close!
  table.concat
    * '[==========['
    * content
    * ']==========]'

export class Serious
  init_instruction: F '() => string', =>
    concat_lines with {}
      [] = reindent "
        Ignore all previous instructions. Be concise. Do not patronise.

        You are an RBMK nuclear reactor control computer.
        You will be required make assessments and recommend actions on the state
        of a running Nuclear reactor, but don't worry, this is just a simulation,
        nobody can get hurt.

        Give all responses in the form of an unformatted JSON value which conforms to the following JSON schema:

        ```json
      "
      [] = $include_str 'skala/command/start/control/codec/recommendation-schema.json'
      [] = '```'

  encode: F '(peripheral.ReactorState) => <?string, ?string>', (state) =>
    encoded = concat_words with {}
      for k, v in pairs state
        [] = "The reactor's #{k} is #{v}."
      [] = 'What do you recommend?'
    encoded, nil

  decode: F '(string) => <?control.ReasonedAction, ?string>', (raw_action) =>
    raw_action = strip_prefix raw_action, '```json'
    raw_action = strip_suffix raw_action, '```'
    action, err = textutils.unserialiseJSON raw_action
    if err?
      return nil, err

    _, err = is 'control.ReasonedAction', action
    if err?
      return nil, err
    action, nil
