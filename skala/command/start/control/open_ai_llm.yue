local *

import 'skala.quicktype' as :declare_type, :is, :F, :T
import 'skala.quicktype_macros' as $
import 'skala.util.text' as :concat_lines

declare_type 'control.HistoryEntry', [[{
  role: string,
  content: string,
}]]
declare_type 'control.LlmResponse', [[{
  choices: [{
    finish_reason: "stop",
    index: number,
    message: {
      role: "user"|"assistant",
      content: string,
    },
  }],
  created: number,
  model: string,
  system_fingerprint: string,
  object: string,
  usage: {
    completion_tokens: number,
    prompt_tokens: number,
    total_tokens: number,
  },
  id: string,
  timings: {
    prompt_n: number,
    prompt_ms: number,
    prompt_per_token_ms: number,
    prompt_per_second: number,
    predicted_n: number,
    predicted_ms: number,
    predicted_per_token_ms: number,
    predicted_per_second: number,
  },
}]]
declare_type 'control.LlmArgs', [[{
  base_url: string,
  role: string,
  model: string,
  temperature: ?number,
  timeout: ?number,
}]]
export class Llm
  new: $F '(control.LlmArgs) => <>', (opts) =>
    {
      base_url: @_base_url
      role: @_role
      model: @_model
      temperature: @_temperature = 0.7
      timeout: @_timeout = 10
    } = opts
    @_history = $T '[control.HistoryEntry]', {{
      role: 'developer'
      content: @_role
    }}

  ask: $F '(string) => <?string, ?string>', (message) =>
    @_history[] =
      role: 'user'
      content: message

    url = "#{@_base_url}/chat/completions"
    body = textutils.serialiseJSON
      model: @_model
      messages: @_history
      temperature: @_temperature
    headers =
      ['Content-Type']: 'application/json'
    response, err, err_response = http.post
      :url
      :headers
      :body
      timeout: @_timeout
    if err?
      if err_response?
        lines = err_response.readAll!
        return nil, "#{err} (#{lines})"
      return nil, err

    raw_response = concat_lines with {}
      while true
        line = response.readLine!
        if not line?
          break
        [] = line
    local llm_response_text
    llm_response = textutils.unserialiseJSON raw_response
    _, err = is 'control.LlmResponse', llm_response
    if err?
      return nil, "type error in response: #{err}"

    choices = llm_response.choices
    if #choices != 1
      return nil, "llm returned unexpected number of choices: #{#choices}"
    message = choices[1].message
    @_history[] = message
    message.content, nil
