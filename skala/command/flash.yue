import 'skala.quicktype' as :declare_type, :F
import 'skala.clap' as :Subcommand, :Param

export register_args = (parser) ->
  parser\add with Subcommand 'flash'
    \description 'default reactor control system'
    \add with Param 'drive'
      \description 'location of disk to flash, if omitted, all sides are searched'
      \default nil

declare_type 'flash.Args', [[{
  drive: ?string,
}]]

export main = F '(flash.Args) -> <>', (args) ->
  { drive: drive_direction } = args

  drive = if drive_direction?
    if 'drive' != peripheral.getType drive_direction
      print "no drive attached to #{direction}"
      return
    -- Race :(
    drive = peripheral.wrap direction
    if not drive?
      print "no drive attached to #{direction}"
      return
    drive
  else
    drives = { peripheral.find 'drive' }
    if #drives == 0
      print 'no drives attached'
      return
    if #drives > 1
      print 'too many drives attached'
      return
    drives[1]

  drive.setDiskLabel 'skala installer'
  mount_path = drive.getMountPath!
  if not mount_path?
    print "disk not mounted"
    return

  fs.copy 'skala', "#{mount_path}/skala"

