-- This is a generated file. It is committed to the repo for the conveineice of
-- not needing to update the build script. This is undesirable, but it is at least
-- quite simple.

import 'skala.quicktype' as :declare_type

declare_type 'server.IngameDateTime', 'string'

declare_type 'server.Request', [[{
  reactor_name: server.ReactorName,
  target_energy_production_rate: number,
  reactor_state: server.ReactorState,
  turbine_state: server.TurbineState,
  timestamp: server.IngameDateTime,
}]]

declare_type 'server.Response', [[{
  reactor_name: server.ReactorName,
  advice: ?server.Advice,
}]]

declare_type 'server.ReactorState', [[
  server.IntactReactorState
  | { integrity: "destroyed" }
]]

declare_type 'server.ReactorMode', '"inactive"|"active"'

declare_type 'server.IntactReactorState', [[{
  integrity: "intact",
  mode: server.ReactorMode,
  temperature: number,
  coolant_filled: number,
  heated_coolant_filled: number,
  fuel_filled: number,
  waste_filled: number,
  actual_burn_rate: number,
  target_burn_rate: number,
  max_burn_rate: number,
  damage_percent: number,
  heating_rate: number,
  boil_efficiency: number,
}]]

declare_type 'server.ReactorName', 'string'

declare_type 'server.Advice', [[{
  action: server.AdvisedAction,
  reasoning: string,
}]]

declare_type 'server.AdvisedAction', [=[{
  kind: "no-action",
} | {
  kind: "scram",
} | {
  kind: "set-burn-rate",
  new_target_burn_rate: number,
}]=]

declare_type 'server.TurbineState', [[
  server.IntactTurbineState
  | { integrity: "destroyed" }
]]

declare_type 'server.IntactTurbineState', [[{
  integrity: "intact",
  stored_kinetic_energy: number,
  energy_production_rate: number,
}]]
