local *

import 'skala.quicktype' as :F, :declare_type
import 'skala.quicktype_macros' as $
import 'skala.peripheral.sole' as :sole

declare_type 'peripheral.Reactor', [[{
  activate: () -> <>,
  scram: () -> <>,
  getStatus: () -> boolean,
  getTemperature: () -> number,
  getCoolantFilledPercentage: () -> number,
  getHeatedCoolantFilledPercentage: () -> number,
  getFuelFilledPercentage: () -> number,
  getWasteFilledPercentage: () -> number,
  getActualBurnRate: () -> number,
  getBurnRate: () -> number,
  getDamagePercent: () -> number,
  getHeatedCoolantFilledPercentage: () -> number,
  getBoilEfficiency: () -> number,
}]]
declare_type 'peripheral.ReactorState', [[{
  mode: "active"|"inactive",
  temperature: number,
  coolant_filled: number,
  heated_coolant_filled: number,
  fuel_filled: number,
  waste_filled: number,
  actual_burn_rate: number,
  target_burn_rate: number,
  damage_percent: number,
  heating_rate: number,
  boil_efficiency: number,
}]]
export class Reactor
  new: (@reactor) =>
    @max_burn_rate = @reactor.getMaxBurnRate!

  @find: $F '() => <?Self, ?string>', =>
    reactor, err = sole 'fissionReactorLogicAdapter'
    if err?
      return nil, err
    ret = @@ reactor
    ret, nil

  scram: $F '() => ?string', =>
    err = nil
    try
      @reactor.scram!
    catch err2
      err = err2
    err

  set_burn_rate: $F '(number) => ?string', (burn_rate) =>
    if burn_rate < 0
      burn_rate = 0
    if burn_rate > @max_burn_rate
      burn_rate = @max_burn_rate

    err = nil
    try
      @reactor.setBurnRate burn_rate
    catch err2
      err = err2
    err

  limits: $F '() => reactor.Limits', =>
    error 'todo'

  state: $F '() => <?peripheral.ReactorState, ?string>', =>
    if not @reactor.isFormed!
      return nil, 'reactor not formed'

    err = nil
    state = nil
    try
      mode = do
        switch @reactor.getStatus!
          when true
            'active'
          when false
            'inactive'
          else
            error 'unreachable'
      state = with {}
        .mode = mode
        .temperature = @reactor.getTemperature!
        .coolant_filled = @reactor.getCoolantFilledPercentage!
        .heated_coolant_filled = @reactor.getHeatedCoolantFilledPercentage!
        .fuel_filled = @reactor.getFuelFilledPercentage!
        .waste_filled = @reactor.getWasteFilledPercentage!
        .actual_burn_rate = @reactor.getActualBurnRate!
        .target_burn_rate = @reactor.getBurnRate!
        .damage_percent = @reactor.getDamagePercent!
        .heating_rate = @reactor.getHeatedCoolantFilledPercentage!
        .boil_efficiency = @reactor.getBoilEfficiency!
    catch err2
      err = err2
    if err?
      return nil, err
    state, nil
