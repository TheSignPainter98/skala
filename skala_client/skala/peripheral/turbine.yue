local *

import 'skala.quicktype' as :F, :declare_type
import 'skala.quicktype_macros' as $
import 'skala.peripheral.sole' as :sole

declare_type 'peripheral.Turbine', [[{
  clear: () => <>,
  setTextScale: (number) => <>,
  setCursorPos: (number, number) => <>,
}]]

export class Turbine
  new: (@turbine) =>

  @find: $F '() => <?Self, ?string>', =>
    turbine, err = sole 'turbineValve'
    if err?
      return nil, err
    ret = @@ turbine
    ret, nil

  intact: $F '() => boolean', =>
    @turbine.isFormed!

  production_rate: $F '() => number', =>
    @turbine.getProductionRate!
    
  energy_filled_percentage: $F '() => number', =>
    @turbine.getEnergyFilledPercentage!
    
  energy: $F '() => number', =>
    @turbine.getEnergy!

  state: $F '() => <?server.TurbineState, ?string>', =>
    ret = nil
    err = nil
    try
      ret = with {}
        if @intact
          .integrity = 'intact'
          .stored_kinetic_energy = @energy!
          .energy_production_rate = @production_rate!
        else
          .integrity = 'destroyed'
    catch err2
      err = err2
    if err?
      return nil, err
    ret, nil
