local *

import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $

export concat_words = (words) -> table.concat words, ' '
export concat_lines = (words) -> table.concat words, '\n'
export strip_prefix = (str, prefix) ->
  if prefix == str\sub 1, #prefix
    str\sub 1 + #prefix
  else
    str
export strip_suffix = (str, suffix) ->
  if suffix == str\sub -#suffix
    str\sub 1, -(1 + #suffix)
  else
    str

export reindent = $F '(string) -> string', (text) ->
  lines = [ line for line in text\gmatch '([^\n]+)' ]

  indent = 99999999
  num_lines = #lines
  for i = 1, num_lines
    if i == num_lines
      continue
    line = lines[i]
    line_indent = line\match '^( *)'
    if #line_indent < indent
      indent = #line_indent

  if indent == 0
    return text
  concat_lines [ line\sub 1 + indent for line in *lines[,-1] ]
