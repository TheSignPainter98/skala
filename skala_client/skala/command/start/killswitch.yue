local *

import 'skala.quicktype' as :declare_type, :F, :T
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand, :Flag
import 'skala.peripheral.reactor' as :Reactor
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger

import 'skala.command.start.killswitch.reactor_temp'
import 'skala.command.start.killswitch.reactor_damage'
import 'skala.command.start.killswitch.reactor_fresh_coolant'
import 'skala.command.start.killswitch.reactor_heated_coolant'

declare_type 'killswitch.KillSwitch', [[{
}]]
killswitches = $T '{string->killswitch.KillSwitch}', {
  :reactor_temp
  :reactor_damage
  :reactor_fresh_coolant
  :reactor_heated_coolant
}
sorted_killswitches = $T '[killswitch.KillSwitch]', do
  sorted_killswitches = [ { :name, :module } for name, module in pairs killswitches ]
  table.sort sorted_killswitches, (a, b) -> a.name < b.name
  sorted_killswitches

declare_type 'killswitch.Action', [[
  "SCRAM"
]]

export register_args = (parser) ->
  command = with Subcommand 'killswitch'
    \description 'reactor auto-shutoff actors'
    \add with Flag 'frequency'
      \description 'how many times per second to check the reactor'
      \takes_param!
      \default 2
      \transform (raw) ->
        if n = tonumber raw
          n, nil
        else
          nil, "#{raw} is not a number"
  for { :module } in *sorted_killswitches
    module.register_args command
  parser\add command

export DEFAULT_CONFIG = do
  lines = with {}
    [] = '[killswitch]'
    [] = 'frequency = 2'
    [] = ''
    [] = '# Killswitch config below. Uncomment one table.'
    for killswitch in *sorted_killswitches
      { :name, :module } = killswitch
      [] = ''
      [] = "# [killswitch.#{name}]"
      for line in *module.DEFAULT_CONFIG_LINES
        [] = "# #{line}"
    [] = ''
  table.concat lines, '\n'

declare_type 'killswitch.Args', [[{
  frequency: number
}]]
export main = $F '(killswitch.Args) -> <>', (args) ->
  { :frequency } = args

  import 'skala.spec' as :repr
  print repr args

  check_reactor = nil
  killswitch_name = nil
  for { :name, :module } in *sorted_killswitches
    a = args[name]
    if not a?
      continue

    if check_reactor?
      error 'multiple killswitches set'
    check_reactor = (reactor) ->
      module.check_reactor a, reactor
    killswitch_name = name
  if not check_reactor? or not killswitch_name?
    error 'no killswitch kind set'

  killswitch_waker = with Waker!
    \add_trigger PeriodicTrigger
      interval: 1 / args.frequency
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      { :hour, :min, :sec } = os.date '!*t'
      print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec

      reactor, err = Reactor::find!
      if err?
        print err
        return

      state, err = reactor\state!
      if err?
        print "cannot get reactor state: #{err}"
        return
      if state.mode != 'active'
        print "skipping killswitch, reactor status is #{state.mode}"
        return

      action, err = check_reactor state
      if err?
        print err

      switch action
        when 'SCRAM'
          print '!!! scramming reactor !!!'
          reactor\scram!
        when nil
          -- Do nothing.
        else
          err ??= "unrecognised action #{action}"

      send_heartbeat {
        :killswitch_waker
        :action
        :err
      }
    \awaken! -- Kick-start
  heartbeat_waker = with Waker!
    \add_trigger PeriodicTrigger
      interval: 1
    \on_awaken -> send_heartbeat :killswitch_name
    \awaken! -- Kick-start
  Waker::run_many
    * killswitch_waker
    * heartbeat_waker

send_heartbeat = $F '({killswitch_name: string}) -> <>', (fields) =>
  heartbeat = T 'control.Heartbeat', {
    id: os.getComputerId!
    type: 'killswitch'
    subtype: killswitch_name
    datetime: os.date '!*t'
    ...fields
  }
  rednet.broadcast heartbeat, 'skala:heartbeat'
