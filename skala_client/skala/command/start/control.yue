local *

import 'skala.clap' as :Subcommand, :Flag
import 'skala.command.start.control.advisor' as :Advisor
import 'skala.command.start.control.report_printer' as :ReportPrinter
import 'skala.peripheral.reactor' as :Reactor
import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger

declare_type 'control.Heartbeat', [[{
  id: number,
  type: string,
  subtype: ?string,
  datetime: {
    hour: number,
    minute: number,
    sec: number,
  }
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'control'
    \description 'default reactor control system'
    \add with Flag 'server-timeout'
      \description 'complete LLM response max seconds'
      \short nil
      \default 30
    \add with Flag 'server-url'
      \description 'URL where the skala server is hosted'
      \short nil
      \default 'http://localhost:15000' -- TODO(kcza): https?

declare_type 'control.Args', [[{
  server_timeout: number,
  server_url: string,
}]]

export DEFAULT_CONFIG = do
  lines =
    * '[control]'
    * ''
  table.concat lines, '\n'

export main = $F '(control.Args) -> <>', (args) ->
  {
    :server_timeout
    :server_url
  } = args
  advisor = Advisor
    base_url: server_url
    timeout: server_timeout
  _, err = advisor\check_health!
  if err?
    print "cannot reach server: #{err}"
    return

  report_printer = ReportPrinter!

  with Waker!
    \add_trigger PeriodicTrigger
      interval: 60 * 5
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      {
        :year
        :month
        :day
        :hour
        :min
        :sec
      } = os.date '!*t'
      print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec

      reactor, err = Reactor::find!
      if err?
        print "cannot find reactor: #{err}"
        return
      reactor_state, err = reactor\state!
      if err?
        print "cannot get reactor state: #{err}"
        -- Continue operation regardless.
        reactor_state = integrity: 'destroyed'
      else
        reactor_state.integrity = 'intact'

      print 'Reactor state is...'
      (require 'cc.pretty').pretty_print reactor_state

      computer_id = os.getComputerID!
      -- Assume one reactor has one controller.
      reactor_name = "reactor_#{computer_id}"

      print 'Requesting advice...'
      timestamp = '%d-%d-%dT%d:%d:%d'\format year, month, day, hour, min, sec
      advice, err = advisor\advice
        :reactor_name
        :reactor_state
        :timestamp
      if err?
        print "Cannot get advice from server: #{err}"
        return

      print 'Got advice:'
      (require 'cc.pretty').pretty_print advice

      -- err = report_printer\print reactor_state, recommendation
      -- if err?
      --   print "cannot print report: #{err}"

      -- {
      --   :action
      -- } = recommendation
      -- switch action
      --   when 'CONTINUE'
      --     print "Taking no action"
      --     -- Do nothing.
      --   when 'SCRAM'
      --     print "Scramming reactor!"
      --     err = reactor\scram!
      --     if err?
      --       print "cannot scram reactor: #{err}"
      --   else
      --     print "unrecognised action: #{action}"
    \awaken! -- Kick-start
    \run!

fe_to_j = (fe) -> fe * 2.5

