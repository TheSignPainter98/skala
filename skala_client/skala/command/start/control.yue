local *

-- Ensure type definitions are included.
require 'skala.command.start.control.codec'

import 'skala.quicktype' as :declare_type, :F
import 'skala.quicktype_macros' as $
import 'skala.clap' as :Subcommand, :Flag
import 'skala.util.waker' as :Waker, :PeriodicTrigger, :RedstoneTrigger
import 'skala.command.start.control.codec.serious' as :Serious
import 'skala.command.start.control.open_ai_llm' as :Llm
import 'skala.command.start.control.report_printer' as :ReportPrinter
import 'skala.peripheral.reactor' as :Reactor

declare_type 'control.Heartbeat', [[{
  id: number,
  type: string,
  subtype: ?string,
  datetime: {
    hour: number,
    minute: number,
    sec: number,
  }
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'control'
    \description 'default reactor control system'
    \add with Flag 'attitude'
      \description 'interaction behaviour with LLM'
      \short nil
      \default 'serious'
      \options
        * 'serious'
        * 'skittish'
        * 'saucy'
    \add with Flag 'llm-timeout'
      \description 'complete LLM response max seconds'
      \short nil
      \default 30

declare_type 'control.Args', [[{
  attitude: control.Attitude,
  llm_timeout: number,
}]]
declare_type 'control.Attitude', [[
  "serious"
  | "skittish"
  | "saucy"
]]

export DEFAULT_CONFIG = do
  lines =
    * '[control]'
    * ''
  table.concat lines, '\n'

export main = $F '(control.Args) -> <>', (args) ->
  {
    :attitude
    llm_timeout: timeout
  } = args
  codec = switch attitude
    when 'serious'
      Serious!
    when 'skittish'
      error 'unimplemented'
    when 'saucy'
      error 'unimplemented'
    else
      error "unrecognised attitude: #{attitude}"
  ai = Ai
    base_url: 'http://localhost:8326/v1'
    model: "qwen-vl"
    :codec
    :timeout
  report_printer = ReportPrinter!

  with Waker!
    \add_trigger PeriodicTrigger
      interval: 60 * 5
    \add_trigger RedstoneTrigger!
    \on_awaken ->
      { :hour, :min, :sec } = os.date '!*t'
      print "[%02d:%02d:%02d]: checking reactor"\format hour, min, sec

      reactor, err = Reactor::find!
      if err?
        print "cannot find reactor: #{err}"
        return
      reactor_state, err = reactor\state!
      if err?
        print "cannot get reactor state: #{err}"
        return

      print 'Reactor state is...'
      (require 'cc.pretty').pretty_print reactor_state

      print 'Requesting advice from AI...'
      recommendation, err = ai\recommend reactor_state
      if err?
        print "cannot get advice from LLM: #{err}"
        return
      print 'Got recommendation:'
      (require 'cc.pretty').pretty_print recommendation

      err = report_printer\print reactor_state, recommendation
      if err?
        print "cannot print report: #{err}"

      {
        :action
      } = recommendation
      switch action
        when 'CONTINUE'
          print "Taking no action"
          -- Do nothing.
        when 'SCRAM'
          print "Scramming reactor!"
          err = reactor\scram!
          if err?
            print "cannot scram reactor: #{err}"
        else
          print "unrecognised action: #{action}"
    \awaken! -- Kick-start
    \run!

fe_to_j = (fe) -> fe * 2.5

declare_type 'control.ReasonedAction', [[
  control.Action + { reasoning: string }
]]
declare_type 'control.Action', [[
  control.NoAction
  | control.ScramAction
]]
declare_type 'control.NoAction', [[{
  action: "CONTINUE"
}]]
declare_type 'control.ScramAction', [[{
  action: "SCRAM",
}]]
declare_type 'control.AiArgs', [[{
  base_url: string,
  model: string,
  codec: control.LlmCodec,
  timeout: ?number,
}]]
class Ai
  new: $F '(control.AiArgs) => <>', (opts) =>
    {
      :base_url
      :model
      codec: @_codec
      :timeout
    } = opts
    init_instruction = @_codec\init_instruction!
    @_llm = Llm
      :base_url
      :init_instruction
      :model
      :timeout

  recommend: $F '(peripheral.ReactorState) => <?control.ReasonedAction, ?string>', (state) =>
    request = @_codec\encode state
    raw_recommendation, err = @_llm\ask request
    if err?
      return nil, err
    recommendation, err = @_codec\decode raw_recommendation
    if err?
      return nil, err
    recommendation, nil
