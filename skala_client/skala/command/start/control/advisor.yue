import 'skala.quicktype' as :declare_type, :is, :F
import 'skala.quicktype_macros' as $
import 'skala.util.text' as :concat_lines
import 'cc.pretty' as :pretty_print

declare_type 'control.Advisor', [[{
  check_health: () => <boolean, ?string>,
  advice: (server.Request) => <?server.Response, ?string>
}]]
declare_type 'control.AdvisorArgs', [[{
  base_url: string,
  timeout: ?number
}]]
export class Advisor
  new: $F '(control.AdvisorArgs) => <>', (opts) =>
    {
      base_url: @_base_url
      timeout: @_timeout = 10
    } = opts

  check_health: $F '() => <boolean, ?string>', =>
    healthcheck_url = "#{@_base_url}/"
    response, err, _ = http.get
      url: healthcheck_url
      timeout: @_timeout
    if err?
      if err_response?
        lines = err_response.readAll!
        return false, "#{err}: #{lines}"
      return false, err
    return true, nil

  advice: $F '(server.Request) => <?server.Response, ?string>', (req) =>
    url = "#{@_base_url}/advice"

    local body
    err = nil
    try
      body = textutils.serialiseJSON req
    catch err2
      err = err2
    if err?
      return nil, err

    headers =
      'Content-Type': 'application/json'
    response, err, err_response = http.post
      :headers
      :url
      :body
      timeout: @_timeout
    if err?
      if err_response?
        lines = err_response.readAll!
        return nil, "#{err}: #{lines}"
      return nil, err

    raw_response = concat_lines with {}
      while true
        line = response.readLine!
        if not line?
          break
        [] = line

    parsed_response, err = textutils.unserialiseJSON raw_response
    if err?
      return nil, "cannot deserialise server response: #{err}"

    print "got advice:"
    pretty_print parsed_response

    _, err = is 'server.Response', parsed_response
    if err?
      return nil, "cannot use returned advice: #{err}"

    parsed_response, nil
