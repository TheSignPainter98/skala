local *

local wrap
try
  import 'cc.strings'
  wrap = strings.wrap
catch _
  wrap = () -> error 'unavailable'

import 'skala.quicktype' as :F, :T, :declare_type
import 'skala.quicktype_macros' as $
import 'skala.peripheral.sole' as :sole

export class ReportPrinter
  new: $F '() => <>', =>

  print: $F '(peripheral.ReactorState, server.Advice) => ?string', (state, reasoned_action) =>
    TICKS_PER_SECOND = 20
    KELVIN_OFFSET = 273.15

    printer, err = sole 'printer'
    if err?
      return err

    if not printer.newPage!
      return 'cannot print due to missing paper, ink or output space'

    print_state = $T '[{name: string, value: string}]', with {}
      {
        :status
        :temperature
        :coolant_filled_percent
        :heated_coolant_filled_percent
        :fuel_filled_percent
        :waste_filled_percent
        :actual_burn_rate
        :target_burn_rate
        :damage_percent
        :heating_rate
        :boil_efficiency_percent
      } = state
      [] =
        name: 'core temp'
        value: '%.2f°C'\format temperature - KELVIN_OFFSET
      [] =
        name: "c'lnt lvl"
        value: '%.2f%%'\format 100 * coolant_filled_percent
      [] =
        name: "hot c'lnt level"
        value: '%.2f%%'\format 100 * heated_coolant_filled_percent
      [] =
        name: 'fuel lvl'
        value: '%.2f%%'\format 100 * fuel_filled_percent
      [] =
        name: 'waste lvl'
        value: '%.2f%%'\format 100 * waste_filled_percent
      [] =
        name: 'burn rate'
        value: '%.2gmB/s'\format actual_burn_rate * TICKS_PER_SECOND
      [] =
        name: 'goal burn rate'
        value: '%.2gmB/s'\format target_burn_rate * TICKS_PER_SECOND
      [] =
        name: 'damage'
        value: '%.2f%%'\format 100 * damage_percent
      [] =
        name: 'heating rate'
        value: '%.2gmB/s'\format heating_rate * TICKS_PER_SECOND
      [] =
        name: 'boil effncy'
        value: '%.2f%%'\format 100 * boil_efficiency_percent

    time = os.time 'ingame'
    hour, hour_frac = math.modf time
    minute, minute_frac = math.modf 60 * hour_frac
    second, _ = math.modf 60 * minute_frac
    time_str = '%02d:%02d:%02d'\format hour, minute, second

    width, height = printer.getPageSize!

    lines = with {}
      [] = '>> S.K.A.L.A. report'
      [] = ">> (#{time_str})"

      [] = ''
      [] = '> Recommendation:'
      [] = ''
      {
        :action
        :reasoning
      } = reasoned_action
      { :kind } = action
      switch kind
        when 'no-action'
          [] = 'No immediate action required.'
        when 'scram'
          [] = 'Scram reactor immediately.'
        when 'set-target-burn-rate'
          { :new_target_burn_rate } = action
          [] = "Set burn rate to #{new_target_burn_rate}"
        else
          [] = "!! invalid action: '#{action}'"
      [] = reasoning

      [] = ''
      [] = '> Reactor state:'
      [] = ''
      longest_name = 0
      longest_value = 0
      entries = with {}
        for state_entry in *print_state
          name = state_entry.print_name ?? state_entry.name
          if #name > longest_name
            longest_name = #name

          value = state_entry.print_value ?? state_entry.value
          if #value > longest_value
            longest_value = #value

          [] =
            :name
            :value
      if #entries == 0
        [] = '-- no data --'
      if longest_name + longest_value + 2 <= width
        for { :name, :value } in *entries
          padding = ' '\rep longest_name - #name
          [] = "#{name}  #{padding}#{value}"
      else
        for { :name, :value } in *entries
          [] = "#{name}: #{value}"

    pages = with {}
      current_page = {}
      for line in *lines
        for l in *wrap line, width
          current_page[] = l
          if #current_page == height
            [] = current_page
          current_page = {}
      if #current_page > 0
        [] = current_page
    pages = do
      pages = {{}}
      for line in *lines
        for l in *wrap line, width
          page = pages[#pages]
          if #page >= height
            page = {}
            pages[] = page
          page[] = l
      pages

    if #pages > printer.getInkLevel!
      return "insufficient ink for #{#pages} pages"
    if #pages > printer.getPaperLevel!
      return "insufficient paper for #{#pages} pages"

    for i = 1, #pages
      page = pages[i]

      if i > 1
        printer.newPage!

      if #pages > 1
        printer.setPageTitle "Skala Reactor Report (#{i}/#{#pages})"
      else
        printer.setPageTitle "Skala Reactor Report"
      for line_num = 1, #page
        printer.setCursorPos 1, line_num
        printer.write page[line_num]

      printer.endPage!

    nil
