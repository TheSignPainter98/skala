local *

import 'skala.clap' as :Flag, :Subcommand
import 'skala.peripheral.monitor' as :Monitor
import 'skala.peripheral.reactor' as :Reactor
import 'skala.peripheral.turbine' as :Turbine
import 'skala.peripheral.sole' as :sole
import 'skala.quicktype' as :declare_type, :is, :F
import 'skala.quicktype_macros' as $
import 'skala.util.text' as :concat_lines

local wrap
try
  import 'cc.strings'
  wrap = strings.wrap
catch _
  wrap = () -> error 'unavailable'

SERVER_TIMEOUT = 10

declare_type 'check.Args', [[{
  server_url: string,
}]]
declare_type 'check.ServerInfo', [[{
  version: string,
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'check'
    \description 'check system health'
    \add with Flag 'server-url'
      \description 'URL where the skala server is hosted'
      \short nil
      \default 'http://localhost:15000' -- TODO(kcza): https?

export main = $F '(check.Args) -> <>', (args) ->
  { :server_url } = args

  local server_status
  server_info, err = get_server_info server_url
  if err?
    server_status = "error! (#{err})"
  else
    server_status = "ok"

  local reactor_status
  _, err = Reactor::find!
  if err?
    reactor_status = "error! (#{err})"
  else
    reactor_status = 'ok'

  local turbine_status
  _, err = Turbine::find!
  if err?
    turbine_status = "error! {#{err}}"
  else
    turbine_status = 'ok'

  local printer_status
  printer, err = sole 'printer'
  if err?
    printer_status = "error! (#{err})"
  else
    printer_status = 'ok'

  printer_ink_status = '-'
  printer_paper_status = '-'
  if printer?
    ink_level = printer.getInkLevel!
    if ink_level == 0
      printer_ink_status = 'empty'
    else if ink_level < 10
      printer_ink_status = 'low'
    else
      printer_ink_status = 'ok'

    paper_level = printer.getPaperLevel!
    if paper_level == 0
      printer_paper_status = 'empty'
    else if paper_level < 10
      printer_paper_status = 'low'
    else
      printer_paper_status = 'ok'

  local monitor_status
  monitor, err = Monitor::find!
  if err?
    monitor_status = "error (#{err})"
  else
    width, height = monitor\size!
    if width < 50
      monitor_status = 'too narrow!'
    else if height < 19
      monitor_status = 'too short!'
    else
      monitor_status = 'ok'

  print render_status_table with {}
    [] =
      name: 'Server'
      status: server_status
    [] =
      name: 'Reactor'
      status: reactor_status
    [] =
      name: 'Turbine'
      status: turbine_status
    [] =
      name: 'Monitor'
      status: monitor_status
    [] =
      name: 'Printer'
      status: printer_status
    [] =
      name: 'Printer ink'
      status: printer_ink_status
    [] =
      name: 'Printer paper'
      status: printer_paper_status
  return

get_server_info = $F '(string) -> <?check.ServerInfo, ?string>', (server_url) ->
  response, err, err_response = http.get
    url: "#{server_url}/info"
    timeout: SERVER_TIMEOUT
  if err?
    if err_response?
      lines = err_response.readAll!
      return nil, "#{err}: #{lines}"
    return nil, err

  raw_response = concat_lines with {}
    while true
      line = response.readLine!
      if not line?
        break
      [] = line

  parsed_response, err = textutils.unserialiseJSON raw_response
  if err?
    return nil, "cannot deserialise server response: #{err}"

  _, err = is 'check.ServerInfo', parsed_response
  if err?
    return nil, "cannot use returned server info: #{err}"
  parsed_response, nil

render_status_table = $F '([{name: string, status: string}]) -> string', (rows) ->
  name_width = 0
  status_width = 0
  for row in *rows
    if #row.name > name_width
      name_width = #row.name
    if #row.status > status_width
      status_width = #row.status
  name_width += 1
  status_width -= 1

  terminal_width = term.getSize!
  status_width = math.max 1,
    math.min status_width,
      terminal_width - name_width - 2

  concat_lines with {}
    for row in *rows
      row_lines = render_status_row row.name, row.status, name_width, status_width
      for line in *row_lines
        [] = line

render_status_row = $F '(string, string, number, number) -> [string]', (name, status, name_width, status_width) ->
  status_lines = wrap status, status_width
  if #status_lines == 0
    return { name }
  with {}
    for i = 1, #status_lines
      status_line = status_lines[i]
      if i == 1
        [] = "#{pad_right name, name_width, '.'}. #{pad_right status_line, status_width}"
      else
        [] = "#{pad_right '', name_width}  #{pad_right status_line, status_width}"

pad_right = $F '(string, number, ?string) -> string', (text, width, pad_char=' ', first_pad_char = ' ') ->
  if #pad_char != 1
    error "cannot use '#{pad_char}' as pad char: expected length 1 but got #{#pad_char}"
  if #first_pad_char != 1
    error "cannot use '#{first_pad_char}' as first pad char: expected length 1 but got #{#first_pad_char}"
  if #text >= width
    return text
  text .. first_pad_char .. (pad_char\rep width - #text - 1)
