local *

import 'skala.clap' as :Flag, :Subcommand
import 'skala.peripheral.monitor' as :Monitor
import 'skala.peripheral.reactor' as :Reactor
import 'skala.peripheral.sole' as :sole
import 'skala.quicktype' as :declare_type, :is, :F
import 'skala.quicktype_macros' as $
import 'skala.util.text' as :concat_lines

SERVER_TIMEOUT = 10

declare_type 'check.Args', [[{
  server_url: string,
}]]
declare_type 'check.ServerInfo', [[{
  version: string,
}]]

export register_args = (parser) ->
  parser\add with Subcommand 'check'
    \description 'check system health'
    \add with Flag 'server-url'
      \description 'URL where the skala server is hosted'
      \short nil
      \default 'http://localhost:15000' -- TODO(kcza): https?

export main = $F '(check.Args) -> <>', (args) ->
  { :server_url } = args

  local server_status
  server_info, err = get_server_info server_url
  if err?
    server_status = "error! (#{err})"
  else
    server_status = "ok"

  local reactor_status
  _, err = Reactor::find!
  if err?
    reactor_status = "error! (#{err})"
  else
    reactor_status = 'ok'

  local printer_status
  printer, err = sole 'printer'
  if err?
    printer_status = "error! (#{err})"
  else
    printer_status = 'ok'

  printer_ink_status = '-'
  printer_paper_status = '-'
  if printer?
    ink_level = printer.getInkLevel!
    if ink_level == 0
      printer_ink_status = 'empty'
    else if ink_level < 10
      printer_ink_status = 'low'
    else
      printer_ink_status = 'ok'

    paper_level = printer.getPaperLevel!
    if paper_level == 0
      printer_paper_status = 'empty'
    else if paper_level < 10
      printer_paper_status = 'low'
    else
      printer_paper_status = 'ok'

  local monitor_status
  monitor, err = Monitor::find!
  if err?
    monitor_status = "error (#{err})"
  else
    width, height = monitor\size!
    print width, height, monitor.monitor.getTextScale!
    if width < 50
      monitor_status = 'too narrow!'
    else if height < 19
      monitor_status = 'too short!'
    else
      monitor_status = 'ok'

  print concat_lines with {}
    [] = "Server:        #{server_status}"
    [] = "Reactor:       #{reactor_status}"
    [] = "Printer:       #{printer_status}"
    [] = "Printer ink:   #{printer_ink_status}"
    [] = "Printer paper: #{printer_paper_status}"
    [] = "Monitor:       #{monitor_status}"
  return

get_server_info = $F '(string) -> <?check.ServerInfo, ?string>', (server_url) ->
  response, err, err_response = http.get
    url: "#{server_url}/info"
    timeout: SERVER_TIMEOUT
  if err?
    if err_response?
      lines = err_response.readAll!
      return nil, "#{err}: #{lines}"
    return nil, err

  raw_response = concat_lines with {}
    while true
      line = response.readLine!
      if not line?
        break
      [] = line

  parsed_response, err = textutils.unserialiseJSON raw_response
  if err?
    return nil, "cannot deserialise server response: #{err}"

  _, err = is 'check.ServerInfo', parsed_response
  if err?
    return nil, "cannot use returned server info: #{err}"
  parsed_response, nil
